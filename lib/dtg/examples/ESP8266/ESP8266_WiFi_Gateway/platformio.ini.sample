; Sample PlatformIO env for ESP8266_WiFi_Gateway / Uplink (esp12e / NodeMCU).
; Copy relevant keys into your project platformio.ini.

[env:esp12e]
platform = espressif8266
board = esp12e
framework = arduino
board_build.ldscript = eagle.flash.4m2m.ld
board_build.filesystem = littlefs
monitor_speed = 115200
lib_deps =
  knolleary/PubSubClient
  bblanchon/ArduinoJson
lib_extra_dirs = ../../../
; Optional global feature overrides (prefer sketch #define before #include <dtg.h>):
; build_flags =
;   -D DTG_WIFI_GATEWAY_ONLY=1
